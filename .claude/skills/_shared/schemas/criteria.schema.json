{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "washvn://schemas/criteria",
  "title": "Criteria Schema",
  "description": "Validation schema for criteria.md (Stage 0 — skill-explorer output)",
  "type": "object",
  "required": [
    "skill_name",
    "acceptance_criteria",
    "test_cases"
  ],
  "additionalProperties": false,
  "properties": {
    "skill_name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "The unique name of the skill in kebab-case"
    },
    "acceptance_criteria": {
      "type": "array",
      "minItems": 5,
      "items": {
        "type": "string"
      },
      "description": "List of acceptance criteria (minimum 5 items)"
    },
    "test_cases": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "name",
          "description",
          "expected_result",
          "type"
        ],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "expected_result": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "pass",
              "fail"
            ]
          }
        }
      },
      "description": "List of test cases (minimum 2 items)"
    },
    "quality_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "meta_criteria_ref": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "edge_cases": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
