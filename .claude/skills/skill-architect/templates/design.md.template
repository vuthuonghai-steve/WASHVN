target_variable: "{target_variable}"
generated_by: "skill-architect"
generated_at: "{generated_at}"
stage: "architect"
status: "in_progress"
zone_mapping:
  core:
    files:
      - path: "SKILL.md"
        file_required: true
        content_type: "persona-definition"
    zone_required: true
  knowledge:
    files:
      - path: "knowledge/{skill_name}-rules.md"
        file_required: true
        content_type: "domain-knowledge"
    zone_required: true
  templates:
    files:
      - path: "templates/{skill_name}.template"
        file_required: false
        content_type: "output-template"
    zone_required: false
  scripts:
    files: []
    zone_required: false
  data:
    files:
      - path: "data/drc.yaml"
        file_required: true
        content_type: "routing-contract"
    zone_required: true
  loop:
    files:
      - path: "loop/design-checklist.md"
        file_required: true
        content_type: "quality-gate"
    zone_required: true
  assets:
    files: []
    zone_required: false
data_contracts:
  - contract_id: "architect-input"
    description: "Three upstream artifacts consumed by architect"
    input_schema: |
      exploration.md: Markdown + YAML frontmatter
        required: [skill_name, stage, problem_statement, resource_audit, scs_score]
      domain-handbook.md: Markdown + YAML frontmatter
        required: [skill_name, glossary(>=10), anti_patterns(>=3), exemplars(>=1)]
      criteria.md: Markdown + YAML frontmatter
        required: [skill_name, acceptance_criteria(>=2)]
    output_schema: |
      design.md: Markdown + YAML frontmatter (design.schema.yaml)
        required: [skill_name, target_variable, zone_mapping, data_contracts, state_machine, must_not_rules]
      data/drc.yaml: YAML (drc_contract_template.yaml)
        lifecycle: WORM
state_machine:
  initial_state: "idle"
  states:
    - "idle"
    - "phase-1-read"
    - "gate-arch-1"
    - "phase-2-zone-mapping"
    - "gate-arch-3"
    - "phase-3-data-contracts"
    - "gate-arch-2"
    - "phase-4-state-diagram"
    - "gate-arch-4"
    - "phase-5-must-not-rules"
    - "gate-meta-2-s1"
    - "phase-6-emit"
    - "gate-final-meta-1-2-3"
    - "complete"
    - "fail-f3-revise"
    - "fail-f8-drift-revise"
must_not_rules:
  - "Phase 1: Must NOT hallucinate input content — trace every claim to source"
  - "Phase 2: Must NOT use placeholder filenames (xxx.md)"
  - "Phase 2: Must NOT omit any of 7 zones from mapping table"
  - "Phase 3: Must NOT define contracts without referencing design.schema.yaml"
  - "Phase 4: Must NOT emit design.md without valid Mermaid stateDiagram in §4"
  - "Phase 5: Must NOT produce fewer than 5 must_not rules per phase"
  - "Phase 6: Must NOT emit with HTML comment placeholders (<!-- -->)"
quality_gates:
  - "ARCH-1: Semantic anchors present in §1 (binary PASS/FAIL)"
  - "ARCH-2: Valid input/output schemas in §3 (binary PASS/FAIL)"
  - "ARCH-3: Complete 7-zone table in §2 (binary PASS/FAIL)"
  - "ARCH-4: Valid stateDiagram in §4 (binary PASS/FAIL)"
  - "META-1: Structural (domain anchor + 6 phases + 7-zone table + frontmatter)"
  - "META-2: Semantic depth (S1 AND S2 AND S3 AND S4)"
  - "META-3: Mechanical (all ARCH pass + token <=700 + zero placeholder)"
iqd_thresholds:
  glossary_size: 10
  semantic_anchor_density_per_200t: 1
  thought_block_depth_min_words: 200
  dual_anchor_types: "technical + stakeholder"
semantic_anchors:
  - "architecture-design-contract-layer"
  - "6-phase-meta-driven-workflow"
  - "semantic-anchor-domain-decomposition"
phase_deconstruction:
  - phase_id: "P1"
    name: "Read"
    description: "Consume 3 inputs, extract anchoring keywords"
  - phase_id: "P2"
    name: "Zone Mapping"
    description: "Map all 7 zones with filenames and constraints"
  - phase_id: "P3"
    name: "Data Contracts"
    description: "Define I/O schemas and DRC routing"
  - phase_id: "P4"
    name: "State Diagram"
    description: "Design Mermaid stateDiagram with fallbacks"
  - phase_id: "P5"
    name: "Must-Not Rules"
    description: "Produce >=5 must_not rules per phase"
  - phase_id: "P6"
    name: "Emit"
    description: "Write design.md + data/drc.yaml and run final gates"
